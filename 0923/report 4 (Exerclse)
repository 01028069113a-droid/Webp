<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>text-shadow와 box-shadow</title>
<style>
  h2 {
    color: orange;
    text-shadow: 3px 3px 5px gray;
  }
  img {
    width: 150px;
    height: 100px;
    margin: 5px;
    border: 1px solid lightgray;
  }
  img:hover {
    box-shadow: 5px 5px 10px gray;
  }
</style>
</head>
<body>
<h2>Most Visited Pages</h2>
<hr>
<img src="site1.png" alt="네이버">
<img src="site2.png" alt="조선일보">
<img src="site3.png" alt="아마존">
</body>
</html>
